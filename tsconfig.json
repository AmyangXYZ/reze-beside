{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["vite/client"],
    "paths": { "@/*": ["../reze-design/*"] }
  },
  "include": ["*.ts", "*.mts", "../reze-design/lib/**/*.ts"],
  "exclude": ["node_modules", "dist", "src-tauri"]
}
