{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reze Beside",
  "version": "0.1.0",
  "identifier": "one.reze.beside",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": {
      "cwd": "..",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "npm run build"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
